rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'leandrosolon@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Perfil privado: só o dono e o admin leem (tem e-mail e nome real).
    // O cliente não pode se dar assinatura nem estender o teste (isSubscribed, createdAt);
    // a assinatura só deve ser gravada por servidor/admin.
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['isSubscribed']);
      allow update: if signedIn() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isSubscribed', 'createdAt']);
      allow delete: if false;
    }

    // Apelidos: registro mínimo { uid, displayName }. Garante apelido único e permite
    // achar um colega pelo apelido exato. Não dá para listar (list = false).
    match /usernames/{key} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'displayName'])
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Livros: qualquer logado pode criar (como dono) e atualizar (empréstimo/
    // devolução mexem no status), mas ninguém troca o dono nem apaga livro alheio.
    match /books/{bookId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Vínculo usuário-livro: cada um altera/apaga só o seu.
    match /user_books/{docId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Grupos: só os membros leem. Entrar = acrescentar a si mesmo (o código vive em
    // club_codes e só quem o conhece descobre o id do grupo). Só o dono altera o resto.
    match /clubs/{clubId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members == [request.auth.uid];

      allow update: if signedIn() && (
        (resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.code == resource.data.code)
        ||
        (!(request.auth.uid in resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberDetails'])
          && request.resource.data.members == resource.data.members.concat([request.auth.uid])
          && request.resource.data.memberDetails.size() == resource.data.get('memberDetails', []).size() + 1)
      );

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Código de convite -> id do grupo. Leitura só por get (sem listar); só o dono cria.
    match /club_codes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['clubId', 'ownerId'])
        && request.resource.data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data.ownerId == request.auth.uid;
      allow update, delete: if false;
    }

    // Trocas e conversas: somente os dois participantes.
    match /exchanges/{exchangeId} {
      allow read, update, delete: if signedIn()
        && (resource.data.initiatorId == request.auth.uid
            || resource.data.receiverId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.initiatorId == request.auth.uid;

      // Mensagens: o chat não tem texto livre. Cada mensagem guarda só um código
      // (presetId do aluno, ou systemKind do sistema); o texto vem do app.
      // Lista de ids sincronizada com src/lib/chatPresets.ts.
      match /messages/{messageId} {
        function isParticipant() {
          let ex = get(/databases/$(database)/documents/exchanges/$(exchangeId)).data;
          return ex.initiatorId == request.auth.uid || ex.receiverId == request.auth.uid;
        }
        function presetIds() {
          return ['oi', 'posso_pegar', 'quando', 'amanha_escola',
                  'pode_sim', 'ainda_lendo', 'combinado', 'outro_dia',
                  'recebi', 'vou_cuidar', 'mais_dias', 'devolvi',
                  'obrigado', 'adorei', 'indicar'];
        }

        allow read: if signedIn() && isParticipant();

        allow create: if signedIn() && isParticipant()
          && request.resource.data.createdAt == request.time
          && (
            // mensagem pronta do aluno
            (request.resource.data.keys().hasOnly(['senderId', 'presetId', 'createdAt'])
              && request.resource.data.senderId == request.auth.uid
              && request.resource.data.presetId in presetIds())
            ||
            // mensagem automática do sistema (códigos fixos, sem texto)
            (request.resource.data.keys().hasOnly(['senderId', 'systemKind', 'createdAt'])
              && request.resource.data.senderId == 'system'
              && request.resource.data.systemKind in ['loan_request', 'chat_opened'])
          );

        allow update, delete: if false;
      }
    }

    // Logs de acesso: qualquer logado grava o próprio; só o admin lê.
    match /access_logs/{logId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
    }
  }
}
