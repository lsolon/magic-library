rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'leandrosolon@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // NOTA: leitura pública mantida porque o cadastro por e-mail verifica se o
    // nome de exibição já existe ANTES do login. Próximo passo: mover essa
    // verificação para uma coleção 'usernames' (só o nome) e fechar esta leitura,
    // pois o documento tem e-mail e nome real.
    match /users/{userId} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == userId;
    }

    // Livros: qualquer logado pode criar (como dono) e atualizar (empréstimo/
    // devolução mexem no status), mas ninguém troca o dono nem apaga livro alheio.
    match /books/{bookId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Vínculo usuário-livro: cada um altera/apaga só o seu.
    match /user_books/{docId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /clubs/{clubId} {
      allow read: if true;
      allow write: if signedIn();
    }

    // Trocas e conversas: somente os dois participantes.
    match /exchanges/{exchangeId} {
      allow read, update, delete: if signedIn()
        && (resource.data.initiatorId == request.auth.uid
            || resource.data.receiverId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.initiatorId == request.auth.uid;

      // Mensagens: o chat não tem texto livre. Cada mensagem guarda só um código
      // (presetId do aluno, ou systemKind do sistema); o texto vem do app.
      // Lista de ids sincronizada com src/lib/chatPresets.ts.
      match /messages/{messageId} {
        function isParticipant() {
          let ex = get(/databases/$(database)/documents/exchanges/$(exchangeId)).data;
          return ex.initiatorId == request.auth.uid || ex.receiverId == request.auth.uid;
        }
        function presetIds() {
          return ['oi', 'posso_pegar', 'quando', 'amanha_escola',
                  'pode_sim', 'ainda_lendo', 'combinado', 'outro_dia',
                  'recebi', 'vou_cuidar', 'mais_dias', 'devolvi',
                  'obrigado', 'adorei', 'indicar'];
        }

        allow read: if signedIn() && isParticipant();

        allow create: if signedIn() && isParticipant()
          && request.resource.data.createdAt == request.time
          && (
            // mensagem pronta do aluno
            (request.resource.data.keys().hasOnly(['senderId', 'presetId', 'createdAt'])
              && request.resource.data.senderId == request.auth.uid
              && request.resource.data.presetId in presetIds())
            ||
            // mensagem automática do sistema (códigos fixos, sem texto)
            (request.resource.data.keys().hasOnly(['senderId', 'systemKind', 'createdAt'])
              && request.resource.data.senderId == 'system'
              && request.resource.data.systemKind in ['loan_request', 'chat_opened'])
          );

        allow update, delete: if false;
      }
    }

    // Logs de acesso: qualquer logado grava o próprio; só o admin lê.
    match /access_logs/{logId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
    }
  }
}
